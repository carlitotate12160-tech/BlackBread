# Normalize line endings: store text as LF in the repo, on every platform.
# Prevents CRLF creeping in from Windows working copies and keeps CI (Linux)
# byte-for-byte consistent with local checkouts.
* text=auto eol=lf

# Explicit LF for the source and config we care about.
*.py    text eol=lf
*.pyi   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf
*.lock  text eol=lf
Dockerfile text eol=lf

# Binary assets: never touch line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.gz    binary
*.zip   binary
