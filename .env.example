# Copy this file to .env and set unique, non-empty values before starting the stack.
# Compose requires these: a missing or empty value stops configuration before any
# container starts. The placeholders are intentionally empty so an unset copy fails
# closed rather than shipping a usable shared credential. Never commit real values.
# See README.md for the fresh-volume and existing-volume procedures.
POSTGRES_MIGRATION_PASSWORD=
BLACKBREAD_RUNTIME_DB_PASSWORD=
BLACKBREAD_ARTIFACT_KEY=
BLACKBREAD_ARTIFACT_ROOT=/var/lib/blackbread/artifacts
# BLACKBREAD_DATABASE_URL has no built-in default. Compose derives it for the api and
# migrate services from the passwords above; set it directly only for a non-Compose run
# (see README.md). It must be a non-empty postgresql+asyncpg URL.
