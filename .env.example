# Copy this file to .env and set unique, non-empty values before starting the stack.
# Compose requires these: a missing or empty value stops configuration before any
# container starts. The placeholders are intentionally empty so an unset copy fails
# closed rather than shipping a usable shared credential. Never commit real values.
# See README.md for the fresh-volume and existing-volume procedures.
# The two passwords are handed to PostgreSQL verbatim and are never interpolated
# into a URL string, so any characters are allowed (including : @ / ? # %).
# Generate e.g. python -c "import secrets; print(secrets.token_urlsafe(24))".
POSTGRES_MIGRATION_PASSWORD=
BLACKBREAD_RUNTIME_DB_PASSWORD=
BLACKBREAD_ARTIFACT_KEY=
BLACKBREAD_ARTIFACT_ROOT=/var/lib/blackbread/artifacts
# Non-Compose runs only: set EITHER BLACKBREAD_DATABASE_URL (a non-empty
# postgresql+asyncpg URL; the test/development alternative) OR the five components
# BLACKBREAD_DB_USER, BLACKBREAD_DB_PASSWORD, BLACKBREAD_DB_HOST, BLACKBREAD_DB_PORT,
# BLACKBREAD_DB_NAME. Setting both is ambiguous and rejected. Compose derives the
# component set for the api and migrate services from the passwords above.
